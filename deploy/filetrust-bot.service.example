[Unit]
Description=filetrust Telegram bot
After=network-online.target

[Service]
User=filetrust
WorkingDirectory=/opt/filetrust/filetrust-bot
Environment=PYTHONPATH=src
ExecStart=/opt/filetrust/filetrust-bot/.venv/bin/python -m filetrust
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/filetrust/filetrust-bot
MemoryMax=768M

[Install]
WantedBy=multi-user.target
